# --- Database (Railway Postgres, or local) ---
DATABASE_URL="postgresql://user:password@host:5432/aischooling"

# --- OpenRouter (https://openrouter.ai/keys) ---
OPENROUTER_API_KEY="sk-or-v1-..."

# Model routing per generation level. Any OpenRouter model slug works.
# Cheaper/faster for structural passes, stronger for lesson prose.
MODEL_OUTLINE="anthropic/claude-3.5-haiku"
MODEL_WEEKS="anthropic/claude-3.5-haiku"
MODEL_LESSONS="anthropic/claude-3.5-sonnet"

# --- App ---
APP_URL="http://localhost:3000"

# Single-user dev identity until Auth.js is wired in.
DEV_USER_EMAIL="myfoodemail001@gmail.com"
DEV_USER_NAME="Dev User"

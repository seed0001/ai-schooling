# --- Database (Railway Postgres, or local) ---
DATABASE_URL="postgresql://user:password@host:5432/aischooling"

# --- OpenRouter (https://openrouter.ai/keys) ---
OPENROUTER_API_KEY="sk-or-v1-..."

# Model routing per generation level. Any OpenRouter model slug works.
# One slug per generation level, so you can route structural passes and lesson
# prose to different models later. Same model everywhere is fine to start.
MODEL_OUTLINE="deepseek/deepseek-v4-flash"
MODEL_WEEKS="deepseek/deepseek-v4-flash"
MODEL_LESSONS="deepseek/deepseek-v4-flash"

# --- App ---
APP_URL="http://localhost:3000"

# Single-user dev identity until Auth.js is wired in.
DEV_USER_EMAIL="myfoodemail001@gmail.com"
DEV_USER_NAME="Dev User"
